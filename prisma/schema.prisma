generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  phone            String?           @unique
  name             String
  email            String?           @unique
  createdAt        DateTime          @default(now())
  systemRole       String            @default("USER")
  passwordHash     String?
  businessMembers  BusinessMember[]
  businessProfiles BusinessProfile[]
}

model OtpToken {
  id         String   @id @default(uuid())
  otpHash    String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  identifier String   @default("")

  @@index([identifier])
}

model BusinessProfile {
  id                String              @id @default(uuid())
  userId            String
  businessName      String
  businessType      String
  vertical          String
  gstin             String?
  pan               String?
  stateCode         String?             @default("27")
  address           String?
  logoUrl           String?
  signatureUrl      String?
  country           String?             @default("India")
  currency          String?             @default("INR")
  language          String?             @default("English")
  timeZone          String?             @default("Asia/Kolkata")
  taxSystem         String?             @default("GST")
  bankName          String?
  bankAccountNo     String?
  ifscCode          String?
  branchName        String?
  upiId             String?
  createdAt         DateTime            @default(now())
  isVerified        Boolean             @default(false)
  branches          Branch[]
  members           BusinessMember[]
  user              User                @relation(fields: [userId], references: [id])
  clients           Client[]
  expenses          Expense[]
  invoices          Invoice[]
  items             Item[]
  partyTransactions PartyTransaction[]
  paymentMethods    PaymentMethod[]
  subscription      TenantSubscription?
}

model SubscriptionPlan {
  id            String               @id @default(uuid())
  name          String
  priceMonthly  Float
  priceYearly   Float
  features      String
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                String           @id @default(uuid())
  businessProfileId String           @unique
  planId            String
  status            String           @default("active")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean          @default(false)
  createdAt         DateTime         @default(now())
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
}

model BusinessMember {
  id                String          @id @default(uuid())
  userId            String
  businessProfileId String
  role              String          @default("STAFF")
  branchId          String?
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  branch            Branch?         @relation(fields: [branchId], references: [id])
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@unique([userId, businessProfileId])
}

model Branch {
  id                String             @id @default(uuid())
  businessProfileId String
  name              String
  address           String?
  phone             String?
  gstin             String?
  isMain            Boolean            @default(false)
  createdAt         DateTime           @default(now())
  businessProfile   BusinessProfile    @relation(fields: [businessProfileId], references: [id])
  members           BusinessMember[]
  expenses          Expense[]
  invoices          Invoice[]
  items             Item[]
  partyTransactions PartyTransaction[]
}

model PaymentMethod {
  id                String          @id @default(uuid())
  businessProfileId String
  type              String
  value             String
  isDefault         Boolean         @default(false)
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
}

model Client {
  id                String             @id @default(uuid())
  businessProfileId String
  name              String
  partyType         String             @default("customer")
  phone             String?
  email             String?
  address           String?
  gstin             String?
  stateCode         String?            @default("27")
  openingBalance    Float              @default(0)
  balanceType       String             @default("receivable")
  creditLimit       Float?
  createdAt         DateTime           @default(now())
  businessProfile   BusinessProfile    @relation(fields: [businessProfileId], references: [id])
  invoices          Invoice[]
  partyTransactions PartyTransaction[]
}

model Item {
  id                String            @id @default(uuid())
  businessProfileId String
  sku               String?
  name              String
  category          String?           @default("General")
  unit              String            @default("Pcs")
  hsnCode           String?           @default("8517")
  salePrice         Float             @default(0)
  purchasePrice     Float             @default(0)
  taxRate           Float             @default(18)
  stockQty          Float             @default(0)
  lowStockThreshold Float             @default(10)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  branchId          String?
  lineItems         InvoiceLineItem[]
  branch            Branch?           @relation(fields: [branchId], references: [id])
  businessProfile   BusinessProfile   @relation(fields: [businessProfileId], references: [id])
  stockMovements    StockMovement[]
}

model StockMovement {
  id           String   @id @default(uuid())
  itemId       String
  changeQty    Float
  movementType String
  referenceId  String?
  notes        String?
  createdAt    DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Expense {
  id                String          @id @default(uuid())
  businessProfileId String
  category          String
  amount            Float
  taxAmount         Float           @default(0)
  vendorName        String?
  gstin             String?
  paymentMode       String          @default("cash")
  date              DateTime        @default(now())
  notes             String?
  createdAt         DateTime        @default(now())
  branchId          String?
  branch            Branch?         @relation(fields: [branchId], references: [id])
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
}

model InvoiceTemplate {
  id         String    @id @default(uuid())
  name       String
  vertical   String
  schemaJson String
  invoices   Invoice[]
}

model Invoice {
  id                String               @id @default(uuid())
  invoiceNo         String
  businessProfileId String
  clientId          String
  templateId        String?
  documentType      String               @default("INVOICE")
  billingType       String               @default("B2B")
  placeOfSupply     String?              @default("27")
  status            String               @default("draft")
  taxableAmount     Float                @default(0)
  cgstAmount        Float                @default(0)
  sgstAmount        Float                @default(0)
  igstAmount        Float                @default(0)
  discountAmount    Float                @default(0)
  totalAmount       Float
  paidAmount        Float                @default(0)
  currency          String               @default("INR")
  dueDate           DateTime?
  publicToken       String               @unique @default(uuid())
  notes             String?
  terms             String?              @default("Payment due within 15 days of invoice date.")
  vehicleNo         String?
  ewayBillNo        String?
  transportMode     String?              @default("road")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  branchId          String?
  activityLogs      ActivityLog[]
  branch            Branch?              @relation(fields: [branchId], references: [id])
  businessProfile   BusinessProfile      @relation(fields: [businessProfileId], references: [id])
  client            Client               @relation(fields: [clientId], references: [id])
  template          InvoiceTemplate?     @relation(fields: [templateId], references: [id])
  customFields      InvoiceCustomField[]
  lineItems         InvoiceLineItem[]
  partyTransactions PartyTransaction[]
  payments          Payment[]
}

model InvoiceLineItem {
  id              String  @id @default(uuid())
  invoiceId       String
  itemId          String?
  description     String
  hsnCode         String? @default("8517")
  qty             Float
  unit            String? @default("Pcs")
  rate            Float
  discountPercent Float   @default(0)
  taxPercent      Float   @default(0)
  cgstAmount      Float   @default(0)
  sgstAmount      Float   @default(0)
  igstAmount      Float   @default(0)
  amount          Float
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item            Item?   @relation(fields: [itemId], references: [id])
}

model InvoiceCustomField {
  id         String  @id @default(uuid())
  invoiceId  String
  fieldKey   String
  fieldValue String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  amount         Float
  mode           String
  transactionRef String?
  status         String
  paidAt         DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
}

model PartyTransaction {
  id                String          @id @default(uuid())
  businessProfileId String
  clientId          String
  type              String
  amount            Float
  paymentMode       String          @default("cash")
  invoiceId         String?
  notes             String?
  date              DateTime        @default(now())
  createdAt         DateTime        @default(now())
  branchId          String?
  branch            Branch?         @relation(fields: [branchId], references: [id])
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  invoiceId String
  action    String
  actor     String?
  timestamp DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}
